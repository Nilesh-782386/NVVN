        function initLiveMap(donorCoords, ngoCoords, volunteerCoords) {
            try {
                console.log('🗺️ Initializing map (volunteerCoords parameter IGNORED - will use REAL GPS):', { 
                    donorCoords, 
                    ngoCoords, 
                    volunteerCoords: 'IGNORED - using REAL GPS instead' 
                });
                
                // Use provided coordinates from API (which uses district-based coordinates)
                // If coordinates are missing, calculate center from available coordinates
                let donorLat, donorLng, ngoLat, ngoLng;
                
                if (donorCoords && donorCoords.lat && donorCoords.lng) {
                    donorLat = donorCoords.lat;
                    donorLng = donorCoords.lng;
                } else {
                    console.warn('⚠️ Donor coordinates missing, will calculate from NGO location');
                    donorLat = null;
                    donorLng = null;
                }
                
                if (ngoCoords && ngoCoords.lat && ngoCoords.lng) {
                    ngoLat = ngoCoords.lat;
                    ngoLng = ngoCoords.lng;
                } else {
                    console.warn('⚠️ NGO coordinates missing, will calculate from donor location');
                    ngoLat = null;
                    ngoLng = null;
                }
                
                // If both are missing, use Maharashtra center as last resort
                if (!donorLat && !ngoLat) {
                    console.error('⚠️ Both donor and NGO coordinates missing, using Maharashtra center');
                    donorLat = 19.7515;
                    donorLng = 75.7139;
                    ngoLat = 19.7515;
                    ngoLng = 75.7139;
                } else if (!donorLat && ngoLat) {
                    // If only donor missing, use NGO location with small offset
                    donorLat = ngoLat + (Math.random() - 0.5) * 0.02;
                    donorLng = ngoLng + (Math.random() - 0.5) * 0.02;
                } else if (donorLat && !ngoLat) {
                    // If only NGO missing, use donor location with small offset
                    ngoLat = donorLat + (Math.random() - 0.5) * 0.02;
                    ngoLng = donorLng + (Math.random() - 0.5) * 0.02;
                }
                
                // Ensure minimum distance between donor and NGO (at least 2km apart)
                if (donorLat && ngoLat) {
                    const distance = calculateDistance(donorLat, donorLng, ngoLat, ngoLng);
                    const minDistance = 0.02; // ~2km in degrees
                    
                    if (distance < minDistance) {
                        console.log('⚠️ Donor and NGO too close, adjusting NGO location');
                        // Move NGO away from donor
                        const angle = Math.random() * Math.PI * 2; // Random direction
                        ngoLat = donorLat + Math.cos(angle) * minDistance;
                        ngoLng = donorLng + Math.sin(angle) * minDistance;
                        console.log('✅ Adjusted NGO location to maintain minimum distance');
                    }
                }
                
                // Calculate center point (but we'll center on REAL GPS location later)
                const centerLat = (donorLat + ngoLat) / 2;
